{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "steps": [
    {
      "step": "defineWpConfigConsts",
      "consts": {
        "DISABLE_WP_CRON": true,
        "WP_DEBUG": false,
        "SCRIPT_DEBUG": false
      }
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "url",
        "url": "https://downloads.wordpress.org/theme/twentytwentyfive.1.5.zip"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require_once '/wordpress/wp-load.php'; wp_delete_post(1, true);"
    },
    {
      "step": "importWxr",
      "file": {
        "resource": "vfs",
        "path": "/fixtures/64-block-test-data.xml"
      }
    },
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "wp-markup-checker"
      }
    }
  ]
}
